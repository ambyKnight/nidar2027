<?xml version='1.0'?>
<sdf version="1.9">
  <model name="iris_lidar">
    <include>
      <uri>model://iris_standoffs_airmouse</uri>
    </include>

    <!--
      visual markers for debugging
      - blade root    - teal
      - blade tip     - orange
      - blade cp      - yellow
      - blade forward - red
      - blade upward  - blue
    -->
