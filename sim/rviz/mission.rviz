Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: 1m grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 24
      Reference Frame: <Fixed Frame>
      Color: 110; 110; 115
      Value: true
    - Class: rviz_default_plugins/Map
      Name: SLAM map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Alpha: 0.9
      Color Scheme: map
      Draw Behind: true
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR scan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Flat Squares
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/TF
      Name: Drone pose (TF)
      Enabled: true
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.6
      Update Interval: 0
      Frame Timeout: 15
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Survivors
      Enabled: true
      Topic:
        Value: /airmouse/survivor_markers
        Depth: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 40
      X: 4
      Y: -2
      Angle: 0
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1100
  Displays:
    collapsed: false
